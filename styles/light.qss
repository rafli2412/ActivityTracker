QWidget {
    background-color: #f4f6fb;
    color: #2b2d42;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QLabel {
    font-weight: 600;
    color: #3d3f5c;
    padding-right: 4px;
}

QLineEdit, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #d7dbec;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #6c5ce7;
}

QLineEdit:focus, QDateEdit:focus {
    border: 1px solid #6c5ce7;
}

QDateEdit::drop-down {
    border: none;
    width: 20px;
}

QPushButton {
    background-color: #6c5ce7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #5a4bd6;
}

QPushButton:pressed {
    background-color: #4b3cc4;
}

QPushButton#delete_btn {
    background-color: #ff6b6b;
}

QPushButton#delete_btn:hover {
    background-color: #f0525c;
}

QPushButton#clear_btn {
    background-color: #a0a4b8;
}

QPushButton#clear_btn:hover {
    background-color: #888ca0;
}

QCheckBox {
    font-weight: 600;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d7dbec;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #6c5ce7;
    border: 1px solid #6c5ce7;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e5f1;
    border-radius: 8px;
    gridline-color: #eef0f8;
    selection-background-color: #d9d3ff;
    selection-color: #2b2d42;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #eceffd;
    color: #3d3f5c;
    padding: 8px;
    border: none;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c8cce0;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a8adc9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
